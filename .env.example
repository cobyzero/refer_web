# ── refer_web · plantilla de variables de entorno ────────────────
# Copiar a `.env` y ajustar:  cp .env.example .env

# Origen del backend (REST + Socket.IO). Sin trailing slash.
APP_BACKEND_URL=http://localhost:3000

# Prefijo de la API REST. Se concatena: API_URL = BACKEND + PATH
APP_API_PATH=/api/v1

# URL completa de la API. Si se define, tiene prioridad sobre BACKEND+PATH.
# APP_API_URL=https://api.midominio.com/api/v1

# Origen del frontend (dev server, e2e, reportes). Sin trailing slash.
APP_BASE_URL=http://localhost:4200

# Entorno: development | production (activa fileReplacement a .production.ts)
APP_ENV=development
